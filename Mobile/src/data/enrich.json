  "lessons": [
    {
      "id": 0,
      "tip": "«We are based in…» تعني «مقرّنا في…» وهي الصيغة المهنية لذكر موقع الشركة. قل «We» لا «I» حين تتحدث باسم نشاطك التجاري.",
      "keywords": [
        {
          "en": "wholesale buyer",
          "ar": "مشترٍ بالجملة"
        },
        {
          "en": "food products",
          "ar": "منتجات غذائية"
        },
        {
          "en": "based in",
          "ar": "مقرّنا في"
        }
      ]
    },
    {
      "id": 1,
      "tip": "بعد «look forward to» يأتي الفعل منتهيًا بـ ing: «hearing» لا «hear». وهي خاتمة مهذبة ثابتة في رسائل العمل.",
      "keywords": [
        {
          "en": "sales manager",
          "ar": "مدير المبيعات"
        },
        {
          "en": "export orders",
          "ar": "طلبات التصدير"
        },
        {
          "en": "email address",
          "ar": "عنوان البريد الإلكتروني"
        }
      ]
    },
    {
      "id": 2,
      "tip": "«per box» تعني «لكل علبة» و«per carton» «لكل كرتون». اسأل عن الوحدة قبل مقارنة أي سعر، فالكرتون يضم عدة علب.",
      "keywords": [
        {
          "en": "per carton",
          "ar": "لكل كرتون"
        },
        {
          "en": "the total",
          "ar": "الإجمالي"
        },
        {
          "en": "currency",
          "ar": "العملة"
        }
      ]
    },
    {
      "id": 3,
      "tip": "حروف الجر مع الوقت: «at ten» للساعة و«in the morning» لجزء اليوم، أما «tomorrow» فتأتي بلا حرف جر.",
      "keywords": [
        {
          "en": "available",
          "ar": "متاح"
        },
        {
          "en": "video call",
          "ar": "مكالمة فيديو"
        },
        {
          "en": "meeting time",
          "ar": "موعد الاجتماع"
        }
      ]
    },
    {
      "id": 4,
      "tip": "النبر يفرّق بين الرقمين: «fifty» (٥٠) نبرها على المقطع الأول، و«fifteen» (١٥) على الأخير. عند الشك اطلب كتابة الرقم.",
      "keywords": [
        {
          "en": "more slowly",
          "ar": "ببطء أكثر"
        },
        {
          "en": "repeat that",
          "ar": "تكرار ذلك"
        },
        {
          "en": "write that down",
          "ar": "كتابة ذلك / تدوينه"
        }
      ]
    },
    {
      "id": 5,
      "tip": "«interested in» تأتي دائمًا مع in، و«looking for» مع for. و«We would like to…» أكثر تهذيبًا من «We want to…».",
      "keywords": [
        {
          "en": "reliable supplier",
          "ar": "مورد موثوق"
        },
        {
          "en": "small order",
          "ar": "طلب صغير"
        },
        {
          "en": "good quality",
          "ar": "جودة جيدة"
        }
      ]
    },
    {
      "id": 6,
      "tip": "«in stock» تعني «متوفر في المخزون» وعكسها «out of stock». و«catalogue» تهجئة بريطانية، وبالأمريكية «catalog».",
      "keywords": [
        {
          "en": "best sellers",
          "ar": "الأكثر مبيعًا"
        },
        {
          "en": "in stock",
          "ar": "متوفر في المخزون"
        },
        {
          "en": "sugar-free",
          "ar": "خالٍ من السكر"
        }
      ]
    },
    {
      "id": 7,
      "tip": "مع المفرد نسأل بـ «Does … contain…?» والفعل بعدها بلا s: «Does it contain milk?» لا «contains».",
      "keywords": [
        {
          "en": "ingredients",
          "ar": "المكونات"
        },
        {
          "en": "allergen information",
          "ar": "معلومات مسببات الحساسية"
        },
        {
          "en": "halal certified",
          "ar": "حاصل على شهادة حلال"
        }
      ]
    },
    {
      "id": 8,
      "tip": "«shelf life» مدة (مثل ١٢ شهرًا) أما «expiry date» فتاريخ محدد. والأهم للمشتري: كم يتبقى منها «on delivery» أي عند التسليم.",
      "keywords": [
        {
          "en": "shelf life",
          "ar": "مدة الصلاحية"
        },
        {
          "en": "expiry date",
          "ar": "تاريخ انتهاء الصلاحية"
        },
        {
          "en": "batch number",
          "ar": "رقم التشغيلة"
        }
      ]
    },
    {
      "id": 9,
      "tip": "«free» هنا تعني «مجاني» لا «حر». و«match» تعني «يطابق»: تأكد دائمًا أن «the sample» تطابق «the final product».",
      "keywords": [
        {
          "en": "samples",
          "ar": "عينات"
        },
        {
          "en": "taste and texture",
          "ar": "الطعم والقوام"
        },
        {
          "en": "feedback",
          "ar": "ملاحظات"
        }
      ]
    },
    {
      "id": 10,
      "tip": "التدرّج من الأصغر إلى الأكبر: «piece» قطعة، ثم «box» علبة، ثم «carton» كرتون. و«How many» تُستخدم للمعدود.",
      "keywords": [
        {
          "en": "net weight",
          "ar": "الوزن الصافي"
        },
        {
          "en": "carton dimensions",
          "ar": "أبعاد الكرتون"
        },
        {
          "en": "individually wrapped",
          "ar": "مغلفة بشكل فردي"
        }
      ]
    },
    {
      "id": 11,
      "tip": "«in bulk» تعني التعبئة بكميات كبيرة لا في عبوات صغيرة. و«colour» تهجئة بريطانية، وفي الأمريكية «color».",
      "keywords": [
        {
          "en": "in bulk",
          "ar": "بكميات كبيرة"
        },
