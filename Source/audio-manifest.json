{
  "items": [
    {
      "text": "Hello, my name is Laith.",
      "file": "b92b7048ebb2adecc2a003d19a6f36fb77fb5c66031317f8e37d67b2e6502e3b.mp3"
    },
    {
      "text": "I am a wholesale buyer.",
      "file": "d2f467ed8cfce68067fc5a487799cde6170aab7980cfd44fc9698e92b4a38b0e.mp3"
    },
    {
      "text": "We sell food products.",
      "file": "cc9a4352512d884a9f9a59f97c5ae7b26721ecd8e3a9a48c09f1b4433aeb0e4f.mp3"
    },
    {
      "text": "We are based in Istanbul.",
      "file": "d5778ebc89d258facb4082b37fe505646e6701fedeec08b9f1a4828dfef37caf.mp3"
    },
    {
      "text": "It is nice to meet you.",
      "file": "8531209a6619810e8d9bce8ed137b7139504aeda17f4bde3aa6d7e24e6f6afae.mp3"
    },
    {
      "text": "What is your name?",
      "file": "b7bc3f438183072baf3ebb11d3d63d781661d4ed7f1f4d79916f89f51f5617f7.mp3"
    },
    {
      "text": "May I speak to the sales manager?",
      "file": "8a4de89f6fdc54a8deded78daadd4c26d459c223155bec0016c54563b0ba2382.mp3"
    },
    {
      "text": "Who handles export orders?",
      "file": "dc333af220d7dc26d2fef52a02108ec2ee6437a9e21d37c8dd52b21724ce0a23.mp3"
    },
    {
      "text": "Could you share your email address?",
      "file": "91d99c78cea9683f4421ee7c586b22cfd76c9c2803d2ee357aed67738e529422.mp3"
    },
    {
      "text": "Can I contact you on WhatsApp?",
      "file": "5cab8ea2d59e83d22189c71ccc75721e9857c8fd5eaf73bd880559e42f7a0e01.mp3"
    },
    {
      "text": "Thank you for your reply.",
      "file": "b24e56eb4fceb2e5de667e4cf953af91c670a8addbc9a8da827c8a66239c4bef.mp3"
    },
    {
      "text": "I look forward to hearing from you.",
      "file": "e347ebfc65ee994d83ae22d3e50874d27800c5136b522a188730024a301bb8ef.mp3"
    },
    {
      "text": "The price is ten dollars.",
      "file": "eb461cb99f8044c7c1a1b9e59595dc78309bb5c77d74749ce64e4f983313aa7e.mp3"
    },
    {
      "text": "We need twenty boxes.",
      "file": "1088f39402021b45d5b31384d10987a9116e020b16d710f97b3fdbed9e82f2ca.mp3"
    },
    {
      "text": "There are twelve pieces in each box.",
      "file": "c4046490c6518d4bfe2da2e3adf67d04a727fdbf772d59b59f14558a37bd7497.mp3"
    },
    {
      "text": "The total is five hundred dollars.",
      "file": "efefd4ab950b8f93502fd25aa84fdbec040f71db79f035317694c219e3616b27.mp3"
    },
    {
      "text": "Is the price per box or per carton?",
      "file": "ff73d4d51cf82902a9d264a59a5fda294fdf76aeb11b050fd0ba67f067c4ac02.mp3"
    },
    {
      "text": "Please confirm the currency.",
      "file": "74cf786063a473805bdede81b8706a168c48d5b263f6c71b7427ace4f0283560.mp3"
    },
    {
      "text": "Are you available tomorrow?",
      "file": "75f76b66e7cd831f6d27fa3b47aa9eddffde82e79f54afb20d2df87e8ec72136.mp3"
    },
    {
      "text": "Can we meet at ten in the morning?",
      "file": "218e2d98e8e5a4781cbe41f83b1d62734e6609f70adcdf51aee7beae8f74de52.mp3"
    },
    {
      "text": "Please send me the factory address.",
      "file": "cf9d04fbabcb4808e284b081728236600b37558810c9dbc1c782d3a65a35c19a.mp3"
    },
    {
      "text": "I would like to visit your showroom.",
      "file": "861e605b2dfb52cc83e22d917f0957316637eea52baddc6b21b07b76212dc410.mp3"
    },
    {
      "text": "Could we arrange a video call?",
      "file": "d27e32bcb1aad7305656c82dd4314c14dbd04c6cebd8904619e4b144e8236fd2.mp3"
    },
    {
      "text": "Let us confirm the meeting time.",
      "file": "1e34ab8a0c606b520cfc7390461909e71d02bfeef89b006a523a239db6d27cf8.mp3"
    },
    {
      "text": "Could you speak more slowly?",
      "file": "1310bd6038d0e880d468a2b8c2e28ce6d2997349fda7d29b2632eef0e0a19817.mp3"
    },
    {
      "text": "Could you repeat that, please?",
      "file": "b31ddce802528151c2a1700aae8c361637c972268d7f0885b5f1cf52356ad351.mp3"
    },
    {
      "text": "What does this word mean?",
      "file": "1203995b8aa2683eb33d975be8704d02cdfd02eaf0b0e2837ec79b946da6ac2d.mp3"
    },
    {
      "text": "Could you write that down?",
      "file": "ee910cd20cd1044a37360c3c4836fd61e5617f111823fd4c559ea70f91958825.mp3"
    },
    {
      "text": "Let me check that I understand.",
      "file": "48eb8e4a5e7a651b3a4a8162e07ed3fb90be10770a02f8e6580ef6c5a4d00750.mp3"
    },
    {
      "text": "Do you mean fifty or fifteen?",
      "file": "e5ca2a4bd7853d33ecb01c5f0175dc1ef52485cb8bdc43b12b24f8e1c7bbaf90.mp3"
    },
    {
      "text": "We supply shops and supermarkets.",
      "file": "87e63998febc1ad39504375bd0387b0acb285914057c48f1eee7fa798bdc0e2a.mp3"
    },
    {
      "text": "We are interested in your products.",
      "file": "8931c880a162c3d9e83dfed83e0e98a5945f77b9684ad1bfdcd565139a7450eb.mp3"
    },
    {
      "text": "We are looking for a reliable supplier.",
      "file": "30fdbee0643880bc817dd4a556d2e5e251714cec92ef24e0de2be2522418e77d.mp3"
    },
    {
      "text": "We would like to start with a small order.",
      "file": "e7981727a4e42cc26df00390742aead0822695998a2443065564161b6b1a9938.mp3"
    },
    {
      "text": "Our customers prefer good quality.",
      "file": "1bcb32e9bf7212422c006b164d27829533dd5593202f236706a592f39006fee1.mp3"
    },
    {
      "text": "Could you tell me about your company?",
      "file": "610b4a94f4ce1dc92ba915a277748f3f4ceb7f9c39622babf68460026437332c.mp3"
    },
    {
      "text": "Could you send me your catalogue?",
      "file": "7e79108906965ca2644cc979be9cd91f79f4d2fb1f6afd55ca649e746f0ca790.mp3"
    },
    {
      "text": "Do you sell dark chocolate?",
      "file": "f15ee149e49a340bdd95ed0bcee5fe996bfb9d2fd7d1d898af3368f282a4de8f.mp3"
    },
    {
      "text": "We are interested in filled chocolates.",
      "file": "336a8087fd100eced407853eea8bf519417fe5d6bdf7c9712c18bf4e76365c07.mp3"
    },
    {
      "text": "Do you offer sugar-free sweets?",
      "file": "6195bf2f7af882a70061dc2bc11d15d990a55dd6f8da838d2063d6a54760fe55.mp3"
    },
    {
      "text": "Which products are your best sellers?",
      "file": "96509de7bf319829ffdb362ffa93b5c08d28c56783428940e6e382a91d1660cb.mp3"
    },
    {
      "text": "Are these items currently in stock?",
      "file": "ad9366062adeb3d38713f0578da2b8b580a997ca8b58da1f0da2e459cc3dd99c.mp3"
    },
    {
      "text": "What are the ingredients?",
      "file": "e723edfedf3285837107ba3a22015e1f8ccd9e5a4bc687ae5945dadaa9838a9e.mp3"
    },
    {
      "text": "Does this product contain nuts?",
      "file": "1cbfa655379dbfd796bd0a9eee0ffcd072aeac8040795e87d777b129c48fecb8.mp3"
    },
    {
      "text": "Does it contain milk or soy?",
      "file": "de37490fa960dc2f91f6e28a302711a3c263d4f9af6c5a55fb7862bc595dc028.mp3"
    },
    {
      "text": "Please send us the allergen information.",
      "file": "fddf7aa101fc82188bdff6e7f1da4e4c3d74b0d1516b6a13c70f44b61aa38530.mp3"
    },
    {
      "text": "Is this product halal certified?",
      "file": "b1bc2be359f64b084a08254d064287cbb2e1bf9d46673b4aba2047aeea7d2027.mp3"
    },
    {
      "text": "Could you share a copy of the certificate?",
      "file": "a1dbc7c57713d3310441f6a5057b0a95106b7b474ecfbedf25d8420eb2f13728.mp3"
    },
    {
      "text": "What is the shelf life?",
      "file": "5b8f626fe1f5e1598b5653edd0f891787db2583a7c15b475e1d09f1f158242bf.mp3"
    },
    {
      "text": "What is the production date?",
      "file": "ec600c8456437be2138710a8a6271d96f12139fe11bce1cd719ed730d489f073.mp3"
    },
    {
      "text": "What is the expiry date?",
      "file": "64bcd6b1bf4a9820163f9a75445207a0cadf40b0bc055fc52674a18ea611be3a.mp3"
    },
    {
      "text": "How much shelf life will remain on delivery?",
      "file": "1440b6c0d8b78b7e1dc905a997ee02424e14d4e4d94c81e20a26dc346c8c59af.mp3"
    },
    {
      "text": "Please confirm the batch number.",
      "file": "7716a5a8122b2255b6a163eba8bbe80132f9b23ffe6f871ee114e81575df42d9.mp3"
    },
    {
      "text": "We need products from a recent batch.",
      "file": "21a8df678567b76d076825fbac86059e731cf53f726daf1ed6bb37c8767c0af4.mp3"
    },
    {
      "text": "Could you send us some samples?",
      "file": "aa8a52e1fad3553f88d9232acfdf686a5c75c8ebac12edd5016d39a418a7d373.mp3"
    },
    {
      "text": "Are the samples free?",
      "file": "2f770634a81621abae0f3b7547975bed96d7339f3ed4110cdb2ddda29adf29f7.mp3"
    },
    {
      "text": "We would like to check the taste and texture.",
      "file": "896772b6fa13b8461e22341405a8976c5ba6e07b46b5e7da17abfcc92657c657.mp3"
    },
    {
      "text": "Does the sample match the final product?",
      "file": "1138a8cb3a9a5bbcbd9b03f71e71c34d211d8adf71d0dd53ae17f0528a41a18b.mp3"
    },
    {
      "text": "The packaging looks good.",
      "file": "7328f0fea5426425f8fa3f48b2593c3f23b3a5801b5ef295b4fc02d8dfc206f5.mp3"
    },
    {
      "text": "We will send our feedback next week.",
      "file": "b916817dd372227de6a944890fb916c541e8c5ea9ac966d81f819323858278db.mp3"
    },
    {
      "text": "What is the weight of each piece?",
      "file": "f46002a86293af4450ca7b55c4377eae274a3b51017da8e8b444c11cef97565a.mp3"
    },
    {
      "text": "How many boxes are in each carton?",
      "file": "b8a9bf7b6e51aa8285d206e83e7665a720118ce30a5ebf954ba8dd6eaf2ef747.mp3"
    },
    {
      "text": "Please confirm the net weight.",
      "file": "e80ce8a9c342b4de30f5c9ec034c9fa6765fd41b73dd9011b8c9b744630338bd.mp3"
    },
    {
      "text": "What are the carton dimensions?",
      "file": "75ac8c9c9b3b8f5c308eff42d85677d37378a7cf8d1bb295fd717d5086edfda6.mp3"
    },
    {
      "text": "Can we order different pack sizes?",
      "file": "4b4b88ba89fc64d216098a4d89c738773012f69054bf6612bd818ac4ec1cdbfd.mp3"
    },
    {
      "text": "We need individually wrapped pieces.",
      "file": "ee0ff177bd1ff906c4217e241d95251d3c30fa0f3ca211d5e405d48b8e7e7eb6.mp3"
    },
    {
      "text": "Do you supply dried tomatoes?",
      "file": "bd37d3ff9233d77b49e2a0f97f120ee2e8e0e1a91fcdf654ce9df772e76cce18.mp3"
    },
    {
      "text": "We are looking for dried apricots.",
      "file": "7549c65ecd69c4ec50bbf341e1d56435307a3b65c2cee20598bd79cdd02bdb70.mp3"
    },
    {
      "text": "Is there any added sugar?",
      "file": "23c70e215b28b660e7abbf1d02247e4efd6c374d8777aaf06f1f6366846f6717.mp3"
    },
    {
      "text": "Are the products packed in bulk?",
      "file": "3ccf22eb123868cd28be0460d917199b57c58061573a5a7e74fe5294410dc05d.mp3"
    },
    {
      "text": "Could you send the product specifications?",
      "file": "3e0909081c96f435995414ff6ffb756153ef2733438519e67721a66f73008ce3.mp3"
    },
    {
      "text": "We need a consistent size and colour.",
      "file": "adc60fb18e5d964dc6e7a1d667018e2ef3a48c63d22de127071c9af94f67d007.mp3"
    },
    {
      "text": "Please send us your wholesale price list.",
      "file": "aba188f678f213101a0fe455af03ebd06aa9cae588da3d06726748cf3c13ec67.mp3"
    },
    {
      "text": "What is the price per carton?",
      "file": "15675cfa661864a6cb9c372e6e2372340f4e7813ef221e7f43132a5b7dc297b4.mp3"
    },
    {
      "text": "Does the price include packaging?",
      "file": "1ece7e7492afd5c8d6474f50397c0a91baa9d81d8dddce39b2099ddb497b1874.mp3"
    },
    {
      "text": "How long is this quotation valid?",
      "file": "6c12ff099b73a1a628d3edb3e9541ad8e5d2fbe614c7078c8ec39df22a595c2f.mp3"
    },
    {
      "text": "Please list the costs separately.",
      "file": "54e018cbd45cec5d528076d5cecb3ee1a6eca4dad858792c6dbfba3fb8946138.mp3"
    },
    {
      "text": "Could you quote for one hundred cartons?",
      "file": "e38417a79b055875e64a8ca725176100624142604e3b28b5e5c24e779ca04ea9.mp3"
    },
    {
      "text": "What is your minimum order quantity?",
      "file": "218d0cff94c93d621e896f958352d908ab25e680c9e254e15eb2df0c29a14074.mp3"
    },
    {
      "text": "Does the minimum apply to each flavour?",
      "file": "79c3cf4003900eb889debc8b4cf1c15d8d638b4178628f79cba129298c3e2ab3.mp3"
    },
    {
      "text": "Can we combine different products?",
      "file": "d3adbda6cc243d8a132d1b90d15f8f59faa2852f952cef96c7e775b72ebef19e.mp3"
    },
    {
      "text": "We would like to place a trial order.",
      "file": "1baddc4842f481c4eb8783995235a193f0997ad8aeb0f6dd7e43a0da09415dee.mp3"
    },
    {
      "text": "Can you reduce the minimum for our first order?",
      "file": "c6b53e74f7df44ad37d3582603a3c8625ba6445aaa477b3b4937a34f09c68e23.mp3"
    },
    {
      "text": "We can increase the quantity later.",
      "file": "7b9eabbae5cf74063f9864b6d1a73ce6f393767339b87257c65872e9c9762786.mp3"
    },
    {
      "text": "Can you offer a better price?",
      "file": "7171f4f3662f9c34fd3eabb02f17e3f4c89ebb5f36075fd3e7ae57cc8a056e28.mp3"
    },
    {
      "text": "Is there a discount for larger orders?",
      "file": "f42a5a7df05725545510a12f1a618ffa5ce25f2d31ddfd2e09dafa5866624881.mp3"
    },
    {
      "text": "Your price is above our budget.",
      "file": "931a281574b6068e36c6f30893e5c1462694139d564d04e2b2a0e3d89ff892e2.mp3"
    },
    {
      "text": "What is your best price for this quantity?",
      "file": "257a353f2acb43ec5c7dadcd26e6e4e549c520d7767489cf65e54bc6d79ade58.mp3"
    },
    {
      "text": "Could you include shipping at this price?",
      "file": "b18ff9c7cfa92975d35a54b393519860b369ac4c36f6d2ed9943fa98c342ad5f.mp3"
    },
    {
      "text": "If we order more, can you lower the unit price?",
      "file": "252ab0557530ace4726a46bb9b1b524148cb167a53a34709a7d3a9921d90cabd.mp3"
    },
    {
      "text": "We are comparing several offers.",
      "file": "7fcb5ae45b446806e610990aa31bb830f4e21c52725f0eb8de9b1a5af4a4fcd9.mp3"
    },
    {
      "text": "Your delivery time is shorter.",
      "file": "ac48e48983c5a61fbd8c7d79ba0e97b800900e7f2eddab2ab62d2fea0d5e7705.mp3"
    },
    {
      "text": "The other offer includes packaging.",
      "file": "e236954a2cdb48f04e7cc787ed629dffc3f08857dedb941eeadb595e70d8d17e.mp3"
    },
    {
      "text": "Quality is more important than a small discount.",
      "file": "2c1e5afe1fcd3fc9ef5985f833071f8601095138cc7faf84700b0415136a692e.mp3"
    },
    {
      "text": "Could you explain the price difference?",
      "file": "187fb8207e47923f24e78f596db208dfea6ae125a659beeac60e1b76d5546658.mp3"
    },
    {
      "text": "We need to compare the same specifications.",
      "file": "e937eee676312665da6cd9d5df06d3fe0278db9bc12ce42bc458e320894d2935.mp3"
    },
    {
      "text": "What are your payment terms?",
      "file": "f089d2b0ea6a994559f088d1000db70487a2cd19c97824cd148629ee4c5d4721.mp3"
    },
    {
      "text": "Please send us a pro forma invoice.",
      "file": "c1147c8c293b5e637fbfe10bffe8b55bd41151071ab7c68f5f34d07ce3f6d196.mp3"
    },
    {
      "text": "Can we pay by bank transfer?",
      "file": "7c27d184397e26d90d658fdb1486ec8d46b9877baca42f7471ea0846fa102e0c.mp3"
    },
    {
      "text": "How much is the deposit?",
      "file": "5491e0fe29ffb3ad0dd9b9b635c8ad63e290d2b12d9e11aa11ba184eef5e487a.mp3"
    },
    {
      "text": "When is the balance due?",
      "file": "056045819639e61d261450afdff47a6a6b87d757f69bfba3f93762f40ca712b5.mp3"
    },
    {
      "text": "Please confirm your bank details in writing.",
      "file": "87d1f89b5bf4a143fa2b72157064b2bbf79cbd0722b80eb75bca6118fed89075.mp3"
    },
    {
      "text": "We would like to confirm our order.",
      "file": "bf41851e25e35e4a97f0720d69c789eb1a2aab7ee24ab4764e6eee2f07db3181.mp3"
    },
    {
      "text": "Please check the quantities on the invoice.",
      "file": "abaf4d8a7cca5bb2e8dccc4eb00ab069ccb3abe72c1f6365ec384eae0cad5217.mp3"
    },
    {
      "text": "The chocolate flavour should be hazelnut.",
      "file": "f64af8f944ddfc90d7d1d960e8f3c4104502f26a3026c962db28ba4a14ffd3af.mp3"
    },
    {
      "text": "Please do not replace any items without approval.",
      "file": "8e875bbd9ee60ceb663f01d73453c9a0bf93ebfd4787066bab055166ab467dc6.mp3"
    },
    {
      "text": "Could you send written confirmation?",
      "file": "12da9ebfd632c5c60845d92a4c85022f3c700f7b7743714b13451d721384502d.mp3"
    },
    {
      "text": "We will proceed once the details are confirmed.",
      "file": "1ee08a3ac0568141a6dd1a4daa66732873376a2f68a1da3ce91b5e454f917d42.mp3"
    },
    {
      "text": "What is the production lead time?",
      "file": "7f7cc4110d91b6f508cbe525b32a8b2114003004a6f52cb3c61880f63285184d.mp3"
    },
    {
      "text": "When will the order be ready?",
      "file": "e1f61e65423129df6288267108f7634deafb74525dcd560dd229057d66349f9f.mp3"
    },
    {
      "text": "Can you meet our requested deadline?",
      "file": "3acf9b815af1a7fbecc6d66888bbfd2dde2861a82e6515a66d4f29e95042ceea.mp3"
    },
    {
      "text": "Please update us on the production status.",
      "file": "4710129f65cb4709315b0922ad09caaba3f20ec9c74038b0944d91c0a1dcb70a.mp3"
    },
    {
      "text": "Let us know if there are any delays.",
      "file": "6488c3690fb2030ec15cb882f0e47fba0649b44ec8869bdc614f7a32c2929f21.mp3"
    },
    {
      "text": "Could you send photos before dispatch?",
      "file": "42bf5ebf348f4241d984eb1beeee14daac374d5666f98a0bc6e3514483a866a8.mp3"
    },
    {
      "text": "How many pallets are in the shipment?",
      "file": "053e9faa9aa14487022e5d02694cdcaa08494f96e88e24a449425d518d7dcf13.mp3"
    },
    {
      "text": "What is the total gross weight?",
      "file": "5a4c460b8060a4285254de4d873758061ca6b55fa9145af0fe5483e9098662ec.mp3"
    },
    {
      "text": "Please secure the cartons on the pallets.",
      "file": "5fcb04a1b685ce534c5b58e2b8337610bba403ce92020052399b7104b068de53.mp3"
    },
    {
      "text": "Are the cartons suitable for export?",
      "file": "3948dc354c144cd6f7c9ab5584662937b12ac32042fc76978571c80ad42eac3e.mp3"
    },
    {
      "text": "Please label each pallet clearly.",
      "file": "e3de9b9ad7b19e75475109b8a43e32339d184023c6de1b5732f052d11930a75e.mp3"
    },
    {
      "text": "Can you confirm the total shipment volume?",
      "file": "b1318c9ae4c0078c8d0fcfe2003e39dd21c7786ca232ce897d919281de9d62a2.mp3"
    },
    {
      "text": "We need a freight quotation.",
      "file": "e3702e4a946a05b8f2ac3a59d5f47424b2781478aed38ffc31084c06080d9d1e.mp3"
    },
    {
      "text": "What is the estimated transit time?",
      "file": "daa5334d3fe2ee5a84255968f18d2c12b844e3c7e32abd866c1584ef1da37b5d.mp3"
    },
    {
      "text": "Does the quote include insurance?",
      "file": "748d917c247c7bbceb24df7d10246f026237ee54b79f1e904659685176526a78.mp3"
    },
    {
      "text": "Are there any additional charges?",
      "file": "56d5ff37b49adbb32489bc7ac3bd9b1d1d0cb7f87439ee4b28030b64764ae4f7.mp3"
    },
    {
      "text": "Please specify the delivery location.",
      "file": "0f6be61e3b9f0523593aeb01ef78ba206ac9a20ac3d531e3fa03d4a8f69236ab.mp3"
    },
    {
      "text": "Could you explain what is included in this price?",
      "file": "2a407afce6509189e2a6f688af26c0419bce0d575256bdbfb335cc7a23bd9688.mp3"
    },
    {
      "text": "Please send us the packing list.",
      "file": "f0d30b6a6ceddad43021335a21d9061dd1b79c571485157e88698b01a2e9ec27.mp3"
    },
    {
      "text": "We need a copy of the commercial invoice.",
      "file": "ccfad533e72d1d765d056e083def9e5d456dbd24426a3b10724b3eecc8dddc17.mp3"
    },
    {
      "text": "Could you send the certificate of origin?",
      "file": "9decdaae6f09b000bf14aa8eb895ab9b44f3ee1edc7e77736755c4a6dde93384.mp3"
    },
    {
      "text": "Please check the consignee details.",
      "file": "8fb11e9bca801740019a90627d8fa4df692e78d8b60ff2ef1a1369de8025109b.mp3"
    },
    {
      "text": "The quantities do not match the packing list.",
      "file": "80a8e3cd3f42def4ce7bf3c2f8776ea1716df3b72574649ec43a7ecdac92e1b4.mp3"
    },
    {
      "text": "Please correct the document before dispatch.",
      "file": "cad6d8a9270d068a4b475645f2d8fc512b2c5edca8470ceecb485e2f2e4674d4.mp3"
    },
    {
      "text": "What storage temperature do you recommend?",
      "file": "3f4b1c72d8092c4652c5957edda3dee0a8a093debbb81ce6f802eecde1deba6a.mp3"
    },
    {
      "text": "How will you protect the chocolate from heat?",
      "file": "fbc0ca8e62ef4dd48d37d1f84034325cd4dd9b59c3343c5ab916a3bbce0cd9f2.mp3"
    },
    {
      "text": "Is temperature-controlled transport available?",
      "file": "d0a75d98df8151200de1c0ce3b492bc7e202307290d93be5ac2d73d6eb94ba7c.mp3"
    },
    {
      "text": "Please keep the products away from direct sunlight.",
      "file": "62a38e96e2fc8d26d54ffb6e31e7737f0e74a07cf073dd478894f4dfd9b96835.mp3"
    },
    {
      "text": "Could you share the storage instructions?",
      "file": "15a691e114077a53a70072166bc757f447063ac9059c1da9e7cc525ce32c1211.mp3"
    },
    {
      "text": "We need to maintain product quality during transport.",
      "file": "afd1f1cb6ae46fcdc7d3b87c3ca9ecc3ab5246c3e2fdad25b4156e6bb3973d07.mp3"
    },
    {
      "text": "Has the shipment left the warehouse?",
      "file": "4d9240de3c9c1f87338d7d896d58c8871b6a7cf63c65c4b85184777ac437d8c7.mp3"
    },
    {
      "text": "Could you send the tracking details?",
      "file": "e19e724981439d253da47edbe2f25f8338e7fe156cc5c0c29dc97000d631a1b4.mp3"
    },
    {
      "text": "What is the expected arrival date?",
      "file": "abae3cefce4c1fe25795ced46a43ae183ded705db0870c15155c0ee2b3da6865.mp3"
    },
    {
      "text": "Please notify us before delivery.",
      "file": "f5289f0700d4238e8603b6b6181a07a77357978f6a767709f35978a50d5366a9.mp3"
    },
    {
      "text": "We have received the shipment.",
      "file": "79bc5be7047d458d7802a72e8a6b8b5427d11d4dc0e0ae2f0e3730307c60a968.mp3"
    },
    {
      "text": "We will inspect the goods today.",
      "file": "20be88853688744d4c854d79af4c6b6de1b62e92cae5012051ce51f794d49e13.mp3"
    },
    {
      "text": "Some cartons arrived damaged.",
      "file": "9f7696d85a0fc70f0b7e7a321477e924badaaa43babc314c5a5def76424b37a1.mp3"
    },
    {
      "text": "There are ten boxes missing.",
      "file": "c97b61b01b264c1a37cbb49dcbc36c74298d2a1c8e80e51fb59a961c29d3db8b.mp3"
    },
    {
      "text": "The products do not match the approved sample.",
      "file": "8259e555b9b9579a6f19a9d325ec9d0634f5eb83e89ea882639277891b3aff9e.mp3"
    },
    {
      "text": "We have attached photos of the damage.",
      "file": "f430efc24521d64d88040670c6d026c6dfddcc7ded72c3beb954be34ba9ce1b1.mp3"
    },
    {
      "text": "Could you investigate this issue?",
      "file": "087d03a8094497d108caadaab600fa78022402aea8b911fbcc43d036842499cb.mp3"
    },
    {
      "text": "Please let us know how you will resolve it.",
      "file": "44f7e552ac1ec6aa6fc75dee56ef8b179a3def241de5f03c0123dbb88f6dd45c.mp3"
    },
    {
      "text": "Could you arrange a replacement?",
      "file": "e0bc31acd1d41ed8ef87b5579fbc71f18488287129d22c7a85f7cf0c661b7827.mp3"
    },
    {
      "text": "We would prefer a refund for the missing items.",
      "file": "31596db93dd507c7a3fe44b07ee7811f0b5fb61108670da7485b2788a638dc8f.mp3"
    },
    {
      "text": "Could you issue a credit note?",
      "file": "f319931aaba8fe1c6549f1de76df511af72b03813cbd8e0266bd354444132b3b.mp3"
    },
    {
      "text": "Please confirm when the replacements will arrive.",
      "file": "a8ebf887ba1e1a17bee11f30d299c37993faecddd33898946d508af59177f68d.mp3"
    },
    {
      "text": "Thank you for resolving this promptly.",
      "file": "e89e1998b264f21363d62cce49b4dde889ed26da715fadd0905e4b89f3566cbf.mp3"
    },
    {
      "text": "Let us agree on a way to prevent this happening again.",
      "file": "e8464589e061a1dd423c0b215dc7dc6a574822e6bc1bc65f936a34ceb13772bb.mp3"
    },
    {
      "text": "Can you produce under our brand name?",
      "file": "e033e08fcd4fdee6038a83805a57d4f5b89102d84432ff97c6a74abc5ef0a0d4.mp3"
    },
    {
      "text": "What is the minimum order for private label products?",
      "file": "45db510ad2006df27aa1ceaa7b1226bcbc0d6ca2329dc981bc57a888e33defc2.mp3"
    },
    {
      "text": "Can you provide Arabic labels?",
      "file": "e74cbff2d928e6e045148e803c2cfc08ad7333f3bb24cd913cb467e333f49980.mp3"
    },
    {
      "text": "Who will prepare the packaging design?",
      "file": "948555936f6f68bb8b86dee3c0dd51a8ef31429ff9a6722def44af8b3643eeb6.mp3"
    },
    {
      "text": "We need to approve the artwork before printing.",
      "file": "a41599c8d6fc13d4b8b009143ac49235ce695615db4fc0bb01e7fad9d70db089.mp3"
    },
    {
      "text": "Please send a packaging sample for approval.",
      "file": "29d1e14924394ed80bd8d2bade964e4dbd523a172aa5aa401ada31120e3de6d0.mp3"
    },
    {
      "text": "We are interested in distributing your products.",
      "file": "a750b6f8ffae70e2cbba6b5ff8141a520f3c2f4f16b5858b8fa185bb48db64d2.mp3"
    },
    {
      "text": "Do you already have a distributor in this market?",
      "file": "d43de407ed6771b7861b0d19d639b7a39c94e0002623e2e43001a25677c3197e.mp3"
    },
    {
      "text": "Which sales channels do you support?",
      "file": "281fe409d88369526d02577a9b55a38a2ab48d24917ee6c6982ac305bee10b8a.mp3"
    },
    {
      "text": "Would you consider an exclusive distribution arrangement?",
      "file": "56d3b4317030578a111f4b43efc8cfe12b44621cca74a94f5f0b84ef34c82a2f.mp3"
    },
    {
      "text": "What sales targets would you expect?",
      "file": "c39cc0bbb9cea5eada0193e994d90ec1488ee71de8ff14d61535f842fa1e4dc2.mp3"
    },
    {
      "text": "We would like to review the proposed terms.",
      "file": "b739dab2333dbd6a486479d5b01ed8c4c6f80e3991ec792a4a5db1510cefee00.mp3"
    },
    {
      "text": "Let us start with the main priorities.",
      "file": "cde62f536ed16006c6138b3c187b2014c7eec147ca5f5a2e2ca470698edcd00c.mp3"
    },
    {
      "text": "Could you clarify your position on pricing?",
      "file": "926894d23571bd2c243c180d69560c589c939e6b57866461cd297b7f28210ecc.mp3"
    },
    {
      "text": "I understand your concern about the order size.",
      "file": "5f930181a4c0b809773631454447bfa66b76fc4080e312b9e8f6a42b63aa0add.mp3"
    },
    {
      "text": "Let us summarise what we have agreed so far.",
      "file": "69b046b8c461ed5388b63725a790d80aacad5127660812ecca2f2d9eb2a4ca18.mp3"
    },
    {
      "text": "Who will be responsible for the next step?",
      "file": "7a40f13ebd55dc120afbe0cd8213842d1d210e34d19217c7ac9be117146e846b.mp3"
    },
    {
      "text": "I will send a summary after the meeting.",
      "file": "066e7d0f52455427df9a247287c19de089fe7b35f742b6d08f03fc5f1b4f8d2f.mp3"
    },
    {
      "text": "I am following up on our previous discussion.",
      "file": "d8328a299e32ed0ccb38020d675e66d22613941b4602ac4b3a18807807404d70.mp3"
    },
    {
      "text": "Please find our order details attached.",
      "file": "4e78a1ab467f28f9d12643df25cc8dd32b0980f8204a282554f963a8a601100e.mp3"
    },
    {
      "text": "Could you confirm receipt of this email?",
      "file": "8504ff2941f4a42a02750a6a7d8241d80fe2d61d2e31745be498746071624548.mp3"
    },
    {
      "text": "We would appreciate a reply by Thursday.",
      "file": "521ab091c0cb4190206e63cdefe55d3f082c83847416fc106f619bbf485fd9d7.mp3"
    },
    {
      "text": "Please let us know if you need further information.",
      "file": "63ba41a8534b9da5a1220d4ec9ada409cecd2de57fe3138d4ec060a763a90567.mp3"
    },
    {
      "text": "Thank you for your continued cooperation.",
      "file": "5cd6786335b3686a28f6bc0a1c829f65541b0bddcc963f440502a0de892754f1.mp3"
    },
    {
      "text": "If you can reduce the price, we can increase the volume.",
      "file": "fd968c98426d375721bb908297df597cbc28b75fb23f53bb6d74f556147c0534.mp3"
    },
    {
      "text": "We could accept this price provided that delivery is included.",
      "file": "221abc918258a396e410e46100b59c8661d39cf3d53dad3d5bbd1ec82c10e0dd.mp3"
    },
    {
      "text": "Would a longer lead time help you offer a better price?",
      "file": "aaed2735db5d268a73c5f5049e1cd4b9fc38d0e4db401d5329bea6f75a648467.mp3"
    },
    {
      "text": "We can be flexible on packaging, but not on quality.",
      "file": "bcdbad75e3f10a0522affb8bd285673df0bbab10668f9989f7153b9b012bb7f2.mp3"
    },
    {
      "text": "What alternatives could you propose?",
      "file": "68f44bf2ac11136f83e9341f42cd1fb8e22e06969d41ea06620bf87e60019edd.mp3"
    },
    {
      "text": "Let us find an arrangement that works for both sides.",
      "file": "56ab2a6e3384ca38bc7f92c720fb522675460c558d5740b7afa874dc73659701.mp3"
    },
    {
      "text": "We appreciate the offer, but the current terms are difficult for us.",
      "file": "d7437b82dfa9e5072775bf6399ec2a055a0526402502c5df4d7ee2b32f85d7b0.mp3"
    },
    {
      "text": "Our main concern is the remaining shelf life.",
      "file": "eac1a3add7d12e47d1cb9aea43c78f0b8126ec09b8df1a93379c81d523d0cb73.mp3"
    },
    {
      "text": "Could you explain the reason for the price increase?",
      "file": "50156202c44e79ad2069c7fb154106acf3e8d18c3d0728c458d3d59009b22f4d.mp3"
    },
    {
      "text": "We cannot commit until the specifications are confirmed.",
      "file": "e69eabd8bf9f8a8640a94f1be6706bcba9f750e5c830e8010e58ca9e645a6026.mp3"
    },
    {
      "text": "We would prefer to postpone rather than compromise on quality.",
      "file": "a57ac678b8c4df2bc1c45b3f1e301314f98c3fbed88efda5baf1a10dae18f683.mp3"
    },
    {
      "text": "We remain interested in finding a suitable solution.",
      "file": "2f93effe14c0f27fb781de38ef920938e94e710406dcd581f2e2cc2ecb55fd86.mp3"
    },
    {
      "text": "We expect demand to increase before the holiday season.",
      "file": "c1962d59a206b2084e84806cda46f1d22a2f72a2d78a0f1ab9b4fd72a013fd68.mp3"
    },
    {
      "text": "These figures are estimates, not confirmed orders.",
      "file": "142c0b0bee45017812844be05bd4ab6a31a8a16e4f7009884cdfd1ed0a80b631.mp3"
    },
    {
      "text": "Could you reserve production capacity for us?",
      "file": "be1f23fabf47db0a44942033a9b50e3e464c773fbdbab379842e30ac3ab4683e.mp3"
    },
    {
      "text": "We would like deliveries to be spread across three months.",
      "file": "512841d66ae2630c7ac710bf063c28d100cae34167c61042409284623e8aa16c.mp3"
    },
    {
      "text": "How much notice do you need for changes?",
      "file": "2eda6b08c1e3ca4b3d6dec197c08d8a7795900661f7100958c619af701918429.mp3"
    },
    {
      "text": "Let us review the forecast at the end of each month.",
      "file": "903f258f4375ee53cd8ce7c05186c99ded7291de3d9f28008920828499bcf9d5.mp3"
    },
    {
      "text": "Could you clarify what this clause covers?",
      "file": "5e21684c2f6b42d70d823711416b5de620cd68c69c95c4d85301e035466cdc3e.mp3"
    },
    {
      "text": "Please specify the responsibilities of each party.",
      "file": "a0d8fb7f4bf3a5038f94bd703652d712bfc51eba32ee7ec0b19699f60e96cb28.mp3"
    },
    {
      "text": "How would changes to the order be handled?",
      "file": "180de4f3142bc579ee682fd50334b569bfe89978d8537729b2f586c0d5fd85b5.mp3"
    },
    {
      "text": "We need a clear process for reporting quality issues.",
      "file": "6c74f545180c2ce71ef1d828500a0df8fcfbf142f8c3942ec1301dc850673b37.mp3"
    },
    {
      "text": "Could we put the agreed changes in writing?",
      "file": "3c85b5041a9838022da533e881458ec16cc18dcaa435cddc31a07f396e47339f.mp3"
    },
    {
      "text": "We will have the draft reviewed before signing.",
      "file": "812e0ddf2a10f93ffb7f2bd1ef2dea51a813db082a5a5e64a73d99bb2e2c45e5.mp3"
    },
    {
      "text": "This delay is affecting our commitments to customers.",
      "file": "1d223edb4eafd851e73ea100a0ea53b33ff5b1974ab01407357a0985cc087d2b.mp3"
    },
    {
      "text": "Could you escalate this to the person responsible?",
      "file": "5ba3ac47fae02cb627bf6eb62eac6d6eb9d73083d5859f6d6bfff979026db912.mp3"
    },
    {
      "text": "We need a realistic recovery plan by tomorrow.",
      "file": "3f93188435871301e27c35ff88738b2f99c84bfc3cfd000f40d5d6f11f5567d9.mp3"
    },
    {
      "text": "Please distinguish confirmed dates from estimates.",
      "file": "a9f0172cd7b4ef724cbbf6274ec46164ce366b8d6d535b5ebdfb07c2c8650496.mp3"
    },
    {
      "text": "Can you suggest a partial shipment as an interim solution?",
      "file": "41f435e4b225148332440819ead73c60fd28c6cff4ebe709defc05c694b2f758.mp3"
    },
    {
      "text": "Let us agree on regular updates until this is resolved.",
      "file": "8b5f0c80cbf89182337b23d2c25c16e922ecfe14fa5d0a317ffb2e8b54fbcea1.mp3"
    },
    {
      "text": "We are ready to proceed on the terms discussed.",
      "file": "4985df5ebafde9d17693592eb1249d18f6f3fdf53150ed99e699c7dde0d6c938.mp3"
    },
    {
      "text": "Before we confirm, let us review the outstanding points.",
      "file": "df37c51ad4e90e62304fce88ed213c458d93e889432faac60f05b3eff3691b84.mp3"
    },
    {
      "text": "Please send the final version for our review.",
      "file": "f3ea6cf24b066dc20634d9b3eb50cd1da6b6e636c426f6bf260fec390e27c51e.mp3"
    },
    {
      "text": "We value a transparent and reliable partnership.",
      "file": "c15d9f1995b7ebcef97e7483ef3faa3486d5f6692cfdd2e19c7dcdb93fa66df9.mp3"
    },
    {
      "text": "Let us schedule a review after the first delivery.",
      "file": "11731c58df2dd50c7a78c211f01d6d0327542997174951efe179a66589d586b9.mp3"
    },
    {
      "text": "We look forward to building a long-term relationship.",
      "file": "ee13acdd4e5b7a33d445814030d5b12212ca161025b14435c43112028350c323.mp3"
    },
    {
      "text": "What percentage of cocoa does this chocolate contain?",
      "file": "7a73e60be4eac9ff5b7713bd6826b4b4f5e9213a941e48ba9be62d2c152bfa47.mp3"
    },
    {
      "text": "We prefer a less sweet filling with a smooth texture.",
      "file": "654b65534dbd036e8d3a33950c342fd80918cf0a55b07054106e4fa266dbcd9f.mp3"
    },
    {
      "text": "Please specify the net weight of each retail pack.",
      "file": "83999ad68b84c9175b29e4922ab8117a697a627b0b3a26f1d4132889b0c82da0.mp3"
    },
    {
      "text": "Does the coating contain cocoa butter or vegetable fat?",
      "file": "c915cb3af120d5a27922498c360c32e968ec19c446d281030508bffe9881c6b9.mp3"
    },
    {
      "text": "We need individually wrapped pieces for wholesale distribution.",
      "file": "4eaa871fc2f85e24c9060546227743cc8bf02223694c11563d33c54e9474c01e.mp3"
    },
    {
      "text": "Please confirm the number of pieces in each carton.",
      "file": "26c2cdcacac7fafa192dae0f145e3976a631309092fd34c522a4af33ea6a3787.mp3"
    },
    {
      "text": "Could you provide the latest ingredient specification sheet?",
      "file": "f09f870ac3e6240ace87778c24d810366f5776f9d59565a7d15ccd04f7cc0fe0.mp3"
    },
    {
      "text": "Is this product made on equipment that also handles nuts?",
      "file": "c0a73a4583192d0ec4e5a518e521b81234969e42b995befd362f6643b5466ef5.mp3"
    },
    {
      "text": "Please send a clear image of the nutrition label.",
      "file": "f867ff32ba488ec1501ac8d5a82f76b4a9048848484a74c0fab47f33dc639639.mp3"
    },
    {
      "text": "We need to review the Arabic label before printing.",
      "file": "bf657a6e319a0c05d64a56db7eece3fd24222b069d7b8b4aa23f687a5d3bfef9.mp3"
    },
    {
      "text": "Can you provide a valid certificate for this product?",
      "file": "905533dd62d609dcd68e440e249b3e4076f0ff7f102a186839f6773f9f22f84f.mp3"
    },
    {
      "text": "Please notify us before making any ingredient changes.",
      "file": "8e1626452128273e5e1b85e961405183b427ee9ece24e0f0301f94cbb72a6619.mp3"
    },
    {
      "text": "We will evaluate the samples for taste and consistency.",
      "file": "c9b15ea13eba520e0def521b56d343f90512734351e5c4ea803b5b99e00f34b7.mp3"
    },
    {
      "text": "The sample packaging does not match the agreed design.",
      "file": "4af56a3322114b1e201c8228d945687890dadd4276c5b8087333c4d0c31af12a.mp3"
    },
    {
      "text": "Please keep an approved sample from this production batch.",
      "file": "955860836fda7d27ac4686732d74e8d6706192bc10039f740ab01c25e23464cc.mp3"
    },
    {
      "text": "Can you send a revised sample with a thicker outer box?",
      "file": "977128d8d059c0c5448fe667f4a899c1c8d817103052d231916f3d3f49bb9246.mp3"
    },
    {
      "text": "Our approval applies only to the specifications listed here.",
      "file": "0eff5b3ed2682ea6de3d225755174bc038ac60b965f941f8b30d1bf30639cacc.mp3"
    },
    {
      "text": "We will confirm the bulk order after sample approval.",
      "file": "9eeea1fbc4302cad75ee72e0ffdb92733c349cb45651ad4782afe29207facf87.mp3"
    },
    {
      "text": "What storage conditions do you recommend for this product?",
      "file": "e6de7832c3991ab09c021e1eb25bcb9a576ffe2f2ae2af74ed70270cf9a69f8c.mp3"
    },
    {
      "text": "Please specify the acceptable temperature range in writing.",
      "file": "56a13c2cb283416aa5d78e6ee30513cd3a3ff418b35004d9f5bd5d62f6707967.mp3"
    },
    {
      "text": "Can the carrier provide a temperature record for the journey?",
      "file": "ee2b6bee5ad772aada8299ef6821b6da19185f3df20ddbd2bfd91664900cc414.mp3"
    },
    {
      "text": "We noticed signs of melting in several chocolate packs.",
      "file": "d88424652256ff8239f4d9bf084c29e8971389e979ebaed5f2035cb5203d5b5b.mp3"
    },
    {
      "text": "Please keep these cartons away from direct sunlight.",
      "file": "f2437258772cb1e251fa3670d7b8416020978495165656647b4d880676c526ea.mp3"
    },
    {
      "text": "We need to agree on a procedure for temperature deviations.",
      "file": "3401bab1e0784a3259f8ab34caf5382f04931e5fd5d49b61a8103492eb34e58e.mp3"
    },
    {
      "text": "Please list the batch numbers on the packing list.",
      "file": "9ef2ca64bd87c8cfeab6cbb28df2ee68670bfa69029c403ddab803c27f6f8d41.mp3"
    },
    {
      "text": "We require at least nine months of remaining shelf life.",
      "file": "ebfce14eee8f36f3dd0c42dcb26b8c03dbfe351f123b08b16a7ffe1bf1c1c69a.mp3"
    },
    {
      "text": "Which customers received products from the affected batch?",
      "file": "3c23846b4bb324c1c56d8d7eb4cc5afdca813c05abb692f4c559a8983d50e656.mp3"
    },
    {
      "text": "Please hold the affected stock until the review is complete.",
      "file": "8133981f941ddb7eaafacd6e7a42743a098c1b62bf10ce602567db4ac1297f6a.mp3"
    },
    {
      "text": "We rotate our stock by the earliest expiry date.",
      "file": "c2e637b7c96f4a3048eaac722d5f82dc1465ebc90fe8b3f3dbab4d70ffdeaaab.mp3"
    },
    {
      "text": "Can you trace this batch back to its production date?",
      "file": "9f851262903a33b5a1bb8e29aa15fa7deb6ae414eeb2b017f6cefdab2a876174.mp3"
    },
    {
      "text": "Our weekly sales have increased faster than expected.",
      "file": "b9db69f0d5ba806e836a766f06e0ae1fa898b0204abce657c1b12c84e3cd11d8.mp3"
    },
    {
      "text": "How much stock is available for immediate dispatch?",
      "file": "d37698b44fa2dc1d297139a72df1938324bf7bbd081b0c7c4ce38c0c9be5374b.mp3"
    },
    {
      "text": "We would like to reserve capacity for the holiday season.",
      "file": "5e70a99c7d18ec45d739ab7a24a514d9131b5fc7d1e13bf835e78761d22b3bf0.mp3"
    },
    {
      "text": "This forecast is an estimate, not a confirmed purchase order.",
      "file": "278a67c434c3a305ae8bc8c61e7581adc338114ec56eae106527e04684f03e2f.mp3"
    },
    {
      "text": "Please propose a reorder schedule based on our sales data.",
      "file": "8157433cd0ff58b63b057aa2ab19021c494882d85953ad5ae6bbada9d94315a7.mp3"
    },
    {
      "text": "We need a backup supplier for our best-selling items.",
      "file": "3fa98904cd83e0324b6d5137b4290b4e431a76756ffa6cb0e64428f37c2272db.mp3"
    },
    {
      "text": "Could you break down the quotation by cost item?",
      "file": "ed6bfa628362930d54204635c13d1c9c8622d69344fa46befd24ed56d0bd7aae.mp3"
    },
    {
      "text": "Our target margin must cover storage and distribution costs.",
      "file": "f73d727167a40404c523ccc11c6374e7c41276a7c9f171a8a4e039b42a071fce.mp3"
    },
    {
      "text": "The lower unit price does not offset the higher freight cost.",
      "file": "7ef14d3ef80291f0b4a744877be41a844b0d444189ef022ebdaf6fbd317c0afa.mp3"
    },
    {
      "text": "Please quote the same quantities so we can compare fairly.",
      "file": "dae2b69c78f84ce0b64e761a51d49d54fb84b9045f29c0601cbf075b21c7a60c.mp3"
    },
    {
      "text": "What exchange rate was used to prepare this quotation?",
      "file": "8af987eb1d22eb836c955e0ee5f6c10b66608bde9200a59738ae6c68b1450888.mp3"
    },
    {
      "text": "We need to calculate the total landed cost before deciding.",
      "file": "e6f2847fee16e0ffee6063449731d24303ce01ad8cbdaa970e6fbce030c96027.mp3"
    },
    {
      "text": "If we commit to quarterly orders, could you improve the price?",
      "file": "5430be0a10a57eba60acd545556cb3465cd2882a6b836420a811f1f11a287df7.mp3"
    },
    {
      "text": "We can accept a longer lead time in exchange for a discount.",
      "file": "0a959ca35a7e6a93cf2b09ce3cfb2fabbc26caeea512df836343da0a3ba0822c.mp3"
    },
    {
      "text": "That proposal is beyond our current budget.",
      "file": "63c52d5e53a929257c28196ee5d8fcb41d3acde9a85a1c04a2af47fc28243089.mp3"
    },
    {
      "text": "What flexibility do you have on the payment schedule?",
      "file": "b402ea9da5d540ff5379405337257ecfd4093ba3066a57fe3f579fdbdda64f6b.mp3"
    },
    {
      "text": "Let us separate the issues and address them one at a time.",
      "file": "2c4e3b6fae443c842578708fd913a33b0e67d3bcc569507cc75439b1ecd031b2.mp3"
    },
    {
      "text": "We are prepared to proceed if these two points are resolved.",
      "file": "a78cd095e8cc0cdc9b7d4d9c852b3f19e6ce3abaf06e0bbd66629795eee159bb.mp3"
    },
    {
      "text": "We propose paying the balance after the agreed inspection.",
      "file": "7b2cb78482b3d4119b2c07629ee4ac93719ad3b93a164470581a9c59c2a4c77e.mp3"
    },
    {
      "text": "Please confirm the payment currency and bank charges.",
      "file": "d6152f284b55feebf0073c8ffd811167ee6054e20fe034e808bf59dc4861ee28.mp3"
    },
    {
      "text": "We need written approval before changing any bank details.",
      "file": "ced3cfd6bff09887d0dcfaeda3817b2973cdeac4ad2ce954ece698cd98e06a6d.mp3"
    },
    {
      "text": "Can we agree on a credit limit for repeat orders?",
      "file": "67c64b2a6926220e27b76d051fb442c767022e030ed1560290430a477c8ef342.mp3"
    },
    {
      "text": "The invoice is overdue; could you confirm the payment date?",
      "file": "6546a72edc634baf82533486cd827e16007edce8de18711ddbe4ad1b04cafeeb.mp3"
    },
    {
      "text": "Please reconcile the outstanding balance with our statement.",
      "file": "c0e01e0d971fa62858aeb81ff337ffb85711bc993e97fdaf0d41ecf5c1c0ade3.mp3"
    },
    {
      "text": "Which territory would the distribution agreement cover?",
      "file": "bc7327f39eb10d7a7395b680318042707444d0990245db79a1df83d894aea8fa.mp3"
    },
    {
      "text": "We would consider exclusivity subject to realistic sales targets.",
      "file": "9d55459b2d32190b748485f4d5f37e65b309f78b88ba8564d1d196d4f0cda42a.mp3"
    },
    {
      "text": "How will online sales be handled within our territory?",
      "file": "26ed311e4ae34f4522b76fbbc6e38f72a1406ad7fc014108ff92ce3d7bbc4e6f.mp3"
    },
    {
      "text": "We suggest reviewing performance every six months.",
      "file": "9e162ff374e5610a9586323811923dea4fb9cf4ed8ea2b58009e6ddb9a0c7959.mp3"
    },
    {
      "text": "Please clarify the conditions for renewing the agreement.",
      "file": "d6e274e25608e0166859015843430c9b0f90b4dba2d828af9f3042d19685dfd0.mp3"
    },
    {
      "text": "We need to agree on how unsold stock will be handled.",
      "file": "148cdbf6d29b295a9e01a45758e987334375685477bd00befcd321ff5b961cff.mp3"
    },
    {
      "text": "Can you manufacture this product under our own brand?",
      "file": "e58c58cbdac1f2025301e8d8b69cf04344969999361ca4aca9e58595c45e90eb.mp3"
    },
    {
      "text": "Who owns the packaging artwork after we pay the design fee?",
      "file": "8e46931173cd334fff0aa9966eb6d4cfe68c241a55cb183841adac068eb3b4b1.mp3"
    },
    {
      "text": "Please confirm the setup cost for the first production run.",
      "file": "193c02eab461b2a096c3cbf88467a97ba77f499fe18fb054fc2130b88edba630.mp3"
    },
    {
      "text": "We need a printed proof before approving mass production.",
      "file": "49df93d4586151971396ecc59a84f5c46b9bdb21cb19769e206586134ae29a33.mp3"
    },
    {
      "text": "No design changes should be made without our written approval.",
      "file": "f5dda7e5f369d2c64daec1b2349fe06cb6336d0ab7438f4f64f5f05a7da9f36f.mp3"
    },
    {
      "text": "Can the remaining packaging be stored for our next order?",
      "file": "3aa28cf22208bab33b7c1be8a8ff3f015a9e89f8ddd6392ada6f76c88fd514f5.mp3"
    },
    {
      "text": "Let me summarise the points we have agreed on today.",
      "file": "8b3b5804f93345fc563e239edb071cca08d99caa6539e47588556e503122014f.mp3"
    },
    {
      "text": "There are two outstanding issues before we can sign.",
      "file": "78b769b2e343bf61e8e0943a02da3fc2f57b97832cdcd746f66809d7c05bacab.mp3"
    },
    {
      "text": "Please identify who is responsible for each action item.",
      "file": "bdab4a30e7ced071ed9391c0a5d78449226ac71ebfeec7d20f5891ceb20fcfc6.mp3"
    },
    {
      "text": "We will review the draft and respond by Thursday.",
      "file": "1e627a29e9a3197777129aa04273c14df9ebf749d14102e393c04ac659a24298.mp3"
    },
    {
      "text": "This email records our discussion and requests your confirmation.",
      "file": "1dd2dce01c1801220560ce443839d4fd3cb664a44014d1dc78e1cada9fb49e5a.mp3"
    },
    {
      "text": "Once the final terms are approved, we can issue the purchase order.",
      "file": "b1e3160e24803fabb3a3fe57a009e29acd53bffd8955a99820769f4beb08e551.mp3"
    },
    {
      "text": "Hello! How can I help you?",
      "file": "b6b6d0954cc126223730c304c8c010c5c0d79bbc9a05f749547be37670c894e4.mp3"
    },
    {
      "text": "We produce chocolates and biscuits.",
      "file": "92acbd5edeb2f8cec9e3f5dee7e044b5b5626b13ff11708bfade6c9e3c2f1442.mp3"
    },
    {
      "text": "We can discuss the products tomorrow morning.",
      "file": "ad81eab8317d00b7ebf08c61ca3c0b62a06fff1284bae31584499fefc2f19be1.mp3"
    },
    {
      "text": "This is our best-selling chocolate.",
      "file": "8e1f65d45efcb6e04376dc7f547f0d8aee7665e32ecfa223223c9b33fe92c39b.mp3"
    },
    {
      "text": "The shelf life is twelve months.",
      "file": "18919e8746193370bd644af76d4f3b5acb24a58f11a6a7a2ec707a8644f575e9.mp3"
    },
    {
      "text": "We will send you samples this week.",
      "file": "75c8cd91f20a56e6257c129533e9bc8037cb653c8da5775323c40b355fcc0e51.mp3"
    },
    {
      "text": "Our minimum is one hundred cartons per flavour.",
      "file": "c2d15ecc670a9eeddeb574400fbd8bbf90b207bd9d5d0220c629fb7355fb7ed7.mp3"
    },
    {
      "text": "This is our standard wholesale price.",
      "file": "34b888fdbc40d7a3a500c08c11ccfb3e9ffc602d89021bd28462ce01d1486a29.mp3"
    },
    {
      "text": "Are you ready to confirm the order?",
      "file": "92beec87905a0419988183a36eee310c63d65c68d82aece0cf980a0cd50ea0dd.mp3"
    },
    {
      "text": "We can dispatch your chocolate next week.",
      "file": "0d7e26ec2b4005ff149ac7c06ff2498efa196839f285b3b28a535b9a16d8031c.mp3"
    },
    {
      "text": "Please check the shipping documents.",
      "file": "7c7fb38166c963aec76b004a123d4cc000de05b3c24952bf499e61460cc80504.mp3"
    },
    {
      "text": "The shipment has left our warehouse.",
      "file": "60683f822dda63860a42b8ae53078fdab72e34a119828c789f8573c6afd9f7f7.mp3"
    },
    {
      "text": "Did the shipment arrive safely?",
      "file": "f1eb1beae0348cfdac9a8ce8fe2a001799f3671e4d43ae698517568a5267b22a.mp3"
    },
    {
      "text": "How would you like us to resolve this?",
      "file": "131c28c85ae671f7d800ae63b9f8139e5129c86ff1fcfafa9c5a05e80d91c1db.mp3"
    },
    {
      "text": "We can send replacement products.",
      "file": "7fdefc54037d7a29a7954b6a929350e47b7f2237630434fadafc4dd1572fb5ec.mp3"
    },
    {
      "text": "We cannot reduce the unit price further.",
      "file": "8196660b484f4cd9c17a26f39666cb4f94c07afb7330ef7b5273dc1382d787af.mp3"
    },
    {
      "text": "Production is delayed by two weeks.",
      "file": "4e21cbe4341298d17dcc61306516f4542de0a05ec7915bd9b13c22d25b45e292.mp3"
    },
    {
      "text": "We agree with the changes discussed.",
      "file": "f6863f36b8542e0a6f79d80d2f8a5e8a0aa74163b5f2d70b3db209e145d03d48.mp3"
    },
    {
      "text": "The shipment was exposed to hot weather.",
      "file": "2988ae3e8e2f69aa27b54feeb4c5397f6361189dfe0d90b19a08cc1828bf53e6.mp3"
    },
    {
      "text": "Are the samples approved?",
      "file": "06e6ffecbe6f82a92fecdb1d436bda8d877dcfed6bbb313bda556edb16a04eb2.mp3"
    },
    {
      "text": "Can we treat your forecast as a confirmed order?",
      "file": "ab5d5e38eeb217f3258a042d0f48b11af7b8e222c52915af14596f3ccda083cf.mp3"
    },
    {
      "text": "We want an exclusive distribution agreement.",
      "file": "8a08634d539fdf61a8406f5766cf7cff4124ba0d34aa5f8441fb359af2cfbacc.mp3"
    },
    {
      "text": "The unit price is fixed for this quarter.",
      "file": "1f47c59530b821f8a8e8157e7a0d40bdebab64ed02a419a5c9d0fa264e4dfe23.mp3"
    },
    {
      "text": "It sounds like we have reached an agreement.",
      "file": "077c75dc937b1c649c96bfcc8fa804767b7b0bcfa04f018614f5b6894715c5e0.mp3"
    }
  ],
  "characters": 13204,
  "count": 312
}